# SwitchBot アプリ > プロフィール > 設定 > アプリバージョンを10回タップ > 開発者向けオプション
SWITCHBOT_TOKEN=ここにトークン
SWITCHBOT_SECRET=ここにシークレットキー
SWITCHBOT_DEVICE_ID=B0E9FEAD76EC

# 待ち受けアドレス
#   127.0.0.1 = この Mac だけ / 0.0.0.0 = 同じ Wi-Fi の端末からも開ける
APP_HOST=0.0.0.0
APP_PORT=5058

# 0.0.0.0 で使うときは必ず設定してください（空だと同じ Wi-Fi の誰でも暗証番号を作れます）
APP_PASSWORD=

# 1 にすると自宅・社内ネットワーク以外からのアクセスも許可します（通常は 0 のまま）
ALLOW_REMOTE=0

# データベースの置き場所（既定は app.py と同じフォルダの data.sqlite3）
# APP_DB_PATH=/Users/yuokumura/python/switchbot_keypad_scheduler/data.sqlite3

# 判定間隔（秒）とタイムゾーン
TICK_SECONDS=30
APP_TZ=Asia/Tokyo
